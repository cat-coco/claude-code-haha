ANTHROPIC_AUTH_TOKEN=your_token_here
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_DEFAULT_HAIKU_MODEL=MiniMax-M2.7-highspeed
ANTHROPIC_DEFAULT_OPUS_MODEL=MiniMax-M2.7-highspeed
ANTHROPIC_DEFAULT_SONNET_MODEL=MiniMax-M2.7-highspeed
ANTHROPIC_MODEL=MiniMax-M2.7-highspeed
API_TIMEOUT_MS=3000000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_TELEMETRY=1

# EFM debug log — write per-turn LLM interaction traces to ./debugLog.log
# (tail -f debugLog.log) for a full picture of user input, outgoing API
# request, streamed assistant/tool_use blocks, tool execution, and turn end.
# Set to 1/true/yes/on to enable. Override path with EFM_DEBUG_LOG_PATH.
EFM_DEBUG_LOG=0
# EFM_DEBUG_LOG_PATH=/absolute/path/to/debugLog.log
